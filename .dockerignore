# Build context is the repository root. Weights and caches never enter a build context: the learning
# image takes weights from a separate bind-mounted build context (--build-context models=models/cache).
models/cache/
corpus/cache/
ocsf/cache/
runtime/bin/
# dev PRIVATE keys never enter an image layer (learning/Dockerfile copies keys/: only the trust store may go in) — P8
keys/dev/
.git/
**/__pycache__/
**/.pytest_cache/
spike/results/
