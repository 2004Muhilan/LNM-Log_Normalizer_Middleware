{
  "schema_version": "1.0.0",
  "spec_id": "draft-asa-302014",
  "description": "Cisco ASA %ASA-6-302014/302016 'Teardown TCP/UDP connection' with a FREE-TEXT TAIL (teardown reason, e.g. 'TCP Reset-I', 'TCP FINs', 'Flow closed by inspection') that may be absent (UDP) and may be followed by '(user)'. The tail is captured as an opaque span — semantic budget, not byte coverage, decides whether that is acceptable for the class.",
  "regex_dialect": "re2",
  "bounds": { "max_event_bytes": 8192, "max_fields": 64, "max_nesting": 4, "max_repeat": 16 },
  "root": [
    { "op": "regex", "pattern": "(?P<msg_id>%(?:ASA|FTD|PIX)-(?:[a-z]+-)?[0-7]-30201[46])",
      "captures": { "msg_id": { "field": "msg_id", "kind": "semantic", "class": "text" } } },
    { "op": "regex", "pattern": ":? ", "captures": {} },
    { "op": "regex",
      "pattern": "Teardown (?P<proto>TCP|UDP|SCTP) connection (?P<conn_id>[0-9]+) for (?P<src_if>[^:]+):(?P<src_host>[^/\\s]+)/(?P<src_port>[0-9]+)(?:\\((?P<src_user_paren>[^()]+)\\))?(?: (?P<src_user>[^\\s(]+))? to (?P<dst_if>[^:]+):(?P<dst_host>[^/\\s]+)/(?P<dst_port>[0-9]+)(?:\\((?P<dst_user_paren>[^()]+)\\))?(?: (?P<dst_user>[^\\s(]+))? duration (?P<duration>[0-9]+:[0-9]{2}:[0-9]{2}) bytes (?P<bytes>[0-9]+)",
      "captures": {
        "src_user_paren": { "field": "src_user_paren", "kind": "semantic", "class": "text" },
        "src_user": { "field": "src_user", "kind": "semantic", "class": "text" },
        "dst_user_paren": { "field": "dst_user_paren", "kind": "semantic", "class": "text" },
        "dst_user": { "field": "dst_user", "kind": "semantic", "class": "text" },
        "proto": { "field": "proto", "kind": "semantic", "class": "word" },
        "conn_id": { "field": "conn_id", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
        "src_if": { "field": "src_if", "kind": "semantic", "class": "text" },
        "src_host": { "field": "src_host", "kind": "semantic", "class": "text" },
        "src_port": { "field": "src_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
        "dst_if": { "field": "dst_if", "kind": "semantic", "class": "text" },
        "dst_host": { "field": "dst_host", "kind": "semantic", "class": "text" },
        "dst_port": { "field": "dst_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
        "duration": { "field": "duration_hms", "kind": "semantic", "class": "text" },
        "bytes": { "field": "bytes", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } }
      } },
    { "op": "optional", "step": { "op": "regex", "pattern": " (?P<reason>[^()]*[^()\\s])",
      "captures": { "reason": { "field": "teardown_reason", "kind": "opaque" } } } },
    { "op": "optional", "step": { "op": "regex", "pattern": " \\((?P<user>[^()]+)\\)",
      "captures": { "user": { "field": "user", "kind": "semantic", "class": "text" } } } }
  ]
}
