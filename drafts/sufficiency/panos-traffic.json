{
  "schema_version": "1.0.0",
  "spec_id": "draft-panos-traffic",
  "description": "Palo Alto PAN-OS TRAFFIC log: CSV payload after syslog-envelope unwrap (RFC3164 'Nov 30 16:09:08 PA-220 ' or octet-counted RFC5424). Cells containing commas are double-quoted (GlobalProtect corpus line: \"Microsoft Windows 10 Pro , 64-bit\"); embedded quotes are doubled per the vendor CSV convention. PAN-OS appends new trailing columns across versions (65 on 8.1, 100+ on 10.x), so extra cells are opaque and missing trailing cells are allowed. Receive/generated times are '%Y/%m/%d %H:%M:%S' on 8.x/9.x and RFC 3339 on 10.x — the ordered formats list handles both in one spec. No timezone is carried: the pack records timezone_confidence unresolved.",
  "regex_dialect": "re2",
  "bounds": { "max_event_bytes": 16384, "max_fields": 256, "max_nesting": 3, "max_repeat": 16 },
  "root": {
    "op": "csv",
    "delimiter": ",",
    "quote": "\"",
    "escape": "doubled",
    "extra_fields": "opaque",
    "missing_fields": "allow",
    "fields": [
      { "field": "future_use_1", "kind": "opaque" },
      { "field": "receive_time", "kind": "semantic", "class": "text",
        "coerce": { "op": "coerce", "to": "timestamp", "on_failure": "reject",
          "formats": [ { "kind": "pattern", "pattern": "%Y/%m/%d %H:%M:%S", "timezone": "source" }, { "kind": "rfc3339", "timezone": "in_value" } ] } },
      { "field": "serial_number", "kind": "semantic", "class": "text" },
      { "field": "type", "kind": "semantic", "class": "word", "coerce": { "op": "coerce", "to": "enum", "on_failure": "reject", "values": ["TRAFFIC"] } },
      { "field": "subtype", "kind": "semantic", "class": "word" },
      { "field": "future_use_2", "kind": "opaque" },
      { "field": "generated_time", "kind": "semantic", "class": "text",
        "coerce": { "op": "coerce", "to": "timestamp", "on_failure": "reject",
          "formats": [ { "kind": "pattern", "pattern": "%Y/%m/%d %H:%M:%S", "timezone": "source" }, { "kind": "rfc3339", "timezone": "in_value" } ] } },
      { "field": "src_ip", "kind": "semantic", "class": "ip", "coerce": { "op": "coerce", "to": "ip", "on_failure": "reject" } },
      { "field": "dst_ip", "kind": "semantic", "class": "ip", "coerce": { "op": "coerce", "to": "ip", "on_failure": "reject" } },
      { "field": "nat_src_ip", "kind": "semantic", "class": "text", "coerce": { "op": "coerce", "to": "ip", "on_failure": "opaque" } },
      { "field": "nat_dst_ip", "kind": "semantic", "class": "text", "coerce": { "op": "coerce", "to": "ip", "on_failure": "opaque" } },
      { "field": "rule_name", "kind": "semantic", "class": "text" },
      { "field": "src_user", "kind": "semantic", "class": "text" },
      { "field": "dst_user", "kind": "semantic", "class": "text" },
      { "field": "application", "kind": "semantic", "class": "text" },
      { "field": "virtual_system", "kind": "semantic", "class": "text" },
      { "field": "src_zone", "kind": "semantic", "class": "text" },
      { "field": "dst_zone", "kind": "semantic", "class": "text" },
      { "field": "inbound_interface", "kind": "semantic", "class": "text" },
      { "field": "outbound_interface", "kind": "semantic", "class": "text" },
      { "field": "log_action", "kind": "semantic", "class": "text" },
      { "field": "future_use_3", "kind": "opaque" },
      { "field": "session_id", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "repeat_count", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "src_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "dst_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "nat_src_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "nat_dst_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "flags", "kind": "semantic", "class": "hex" },
      { "field": "protocol", "kind": "semantic", "class": "word" },
      { "field": "action", "kind": "semantic", "class": "text" },
      { "field": "bytes", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "bytes_sent", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "bytes_received", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "packets", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "start_time", "kind": "semantic", "class": "text",
        "coerce": { "op": "coerce", "to": "timestamp", "on_failure": "opaque",
          "formats": [ { "kind": "pattern", "pattern": "%Y/%m/%d %H:%M:%S", "timezone": "source" }, { "kind": "rfc3339", "timezone": "in_value" } ] } },
      { "field": "elapsed_time", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "category", "kind": "semantic", "class": "text" },
      { "field": "future_use_4", "kind": "opaque" },
      { "field": "sequence_number", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "action_flags", "kind": "semantic", "class": "hex" },
      { "field": "src_country", "kind": "semantic", "class": "text" },
      { "field": "dst_country", "kind": "semantic", "class": "text" },
      { "field": "future_use_5", "kind": "opaque" },
      { "field": "packets_sent", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "packets_received", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      { "field": "session_end_reason", "kind": "semantic", "class": "text" },
      { "field": "dg_hierarchy_level_1", "kind": "semantic", "class": "text" },
      { "field": "dg_hierarchy_level_2", "kind": "semantic", "class": "text" },
      { "field": "dg_hierarchy_level_3", "kind": "semantic", "class": "text" },
      { "field": "dg_hierarchy_level_4", "kind": "semantic", "class": "text" },
      { "field": "virtual_system_name", "kind": "semantic", "class": "text" },
      { "field": "device_name", "kind": "semantic", "class": "text" },
      { "field": "action_source", "kind": "semantic", "class": "text" },
      { "field": "src_vm_uuid", "kind": "semantic", "class": "text" },
      { "field": "dst_vm_uuid", "kind": "semantic", "class": "text" },
      { "field": "tunnel_id_imsi", "kind": "semantic", "class": "text" },
      { "field": "monitor_tag_imei", "kind": "semantic", "class": "text" },
      { "field": "parent_session_id", "kind": "semantic", "class": "text" },
      { "field": "parent_start_time", "kind": "semantic", "class": "text" },
      { "field": "tunnel_type", "kind": "semantic", "class": "text" },
      { "field": "sctp_association_id", "kind": "semantic", "class": "text" },
      { "field": "sctp_chunks", "kind": "semantic", "class": "text" },
      { "field": "sctp_chunks_sent", "kind": "semantic", "class": "text" },
      { "field": "sctp_chunks_received", "kind": "semantic", "class": "text" }
    ]
  }
}
