{
  "schema_version": "1.0.0",
  "spec_id": "draft-fortigate-traffic",
  "description": "FortiGate type=traffic KV log, payload after the '<PRI>' syslog-envelope unwrap. Keys are optional and vary per line (30–57 of a 72-key union in the corpus); values are bare or double-quoted with backslash escapes and may contain spaces, '=' and '/' inside quotes. date= and time= are separate keys composed into the event time by the pack mapping (compose_datetime with tz= when present); eventtime is epoch seconds on older FortiOS and epoch nanoseconds on 6.2+, handled by epoch_auto. Keys not declared here are recorded as opaque unknown.<key> spans rather than rejected — that is the arity-bucket/optional-field case the FortiGate family exists to exercise.",
  "regex_dialect": "re2",
  "bounds": { "max_event_bytes": 16384, "max_fields": 256, "max_nesting": 3, "max_repeat": 16 },
  "root": {
    "op": "kv",
    "pair_separator": { "whitespace_run": true },
    "key_value_separator": "=",
    "quote": "\"",
    "escape": "backslash",
    "key_pattern": "[a-z][a-z0-9_]*",
    "unknown_keys": "opaque",
    "order": "any",
    "allow_bare_keys": false,
    "keys": {
      "date": { "field": "date", "kind": "semantic", "class": "text", "coerce": { "op": "coerce", "to": "timestamp", "on_failure": "reject", "format": { "kind": "pattern", "pattern": "%Y-%m-%d", "timezone": "source" } } },
      "time": { "field": "time", "kind": "semantic", "class": "text" },
      "tz": { "field": "tz", "kind": "semantic", "class": "text" },
      "eventtime": { "field": "eventtime", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "timestamp", "on_failure": "opaque", "format": { "kind": "epoch_auto", "timezone": "utc" } } },
      "devname": { "field": "devname", "kind": "semantic", "class": "text" },
      "devid": { "field": "devid", "kind": "semantic", "class": "text" },
      "logid": { "field": "logid", "kind": "semantic", "class": "text" },
      "type": { "field": "type", "kind": "semantic", "class": "word", "coerce": { "op": "coerce", "to": "enum", "on_failure": "reject", "values": ["traffic"] } },
      "subtype": { "field": "subtype", "kind": "semantic", "class": "word" },
      "level": { "field": "level", "kind": "semantic", "class": "word" },
      "vd": { "field": "vd", "kind": "semantic", "class": "text" },
      "srcip": { "field": "srcip", "kind": "semantic", "class": "ip", "coerce": { "op": "coerce", "to": "ip", "on_failure": "reject" } },
      "srcport": { "field": "srcport", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "srcintf": { "field": "srcintf", "kind": "semantic", "class": "text" },
      "srcintfrole": { "field": "srcintfrole", "kind": "semantic", "class": "text" },
      "srcmac": { "field": "srcmac", "kind": "semantic", "class": "mac" },
      "mastersrcmac": { "field": "mastersrcmac", "kind": "semantic", "class": "mac" },
      "srcserver": { "field": "srcserver", "kind": "semantic", "class": "text" },
      "srcuuid": { "field": "srcuuid", "kind": "semantic", "class": "text" },
      "srccountry": { "field": "srccountry", "kind": "semantic", "class": "text" },
      "dstip": { "field": "dstip", "kind": "semantic", "class": "ip", "coerce": { "op": "coerce", "to": "ip", "on_failure": "reject" } },
      "dstport": { "field": "dstport", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "dstintf": { "field": "dstintf", "kind": "semantic", "class": "text" },
      "dstintfrole": { "field": "dstintfrole", "kind": "semantic", "class": "text" },
      "dstuuid": { "field": "dstuuid", "kind": "semantic", "class": "text" },
      "dstcountry": { "field": "dstcountry", "kind": "semantic", "class": "text" },
      "sessionid": { "field": "sessionid", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "proto": { "field": "proto", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "action": { "field": "action", "kind": "semantic", "class": "word" },
      "utmaction": { "field": "utmaction", "kind": "semantic", "class": "word" },
      "utmref": { "field": "utmref", "kind": "semantic", "class": "text" },
      "policyid": { "field": "policyid", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "policyname": { "field": "policyname", "kind": "semantic", "class": "text" },
      "policytype": { "field": "policytype", "kind": "semantic", "class": "text" },
      "poluuid": { "field": "poluuid", "kind": "semantic", "class": "text" },
      "service": { "field": "service", "kind": "semantic", "class": "text" },
      "trandisp": { "field": "trandisp", "kind": "semantic", "class": "word" },
      "transip": { "field": "transip", "kind": "semantic", "class": "ip", "coerce": { "op": "coerce", "to": "ip", "on_failure": "opaque" } },
      "transport": { "field": "transport", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "opaque" } },
      "duration": { "field": "duration", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "sentbyte": { "field": "sentbyte", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "rcvdbyte": { "field": "rcvdbyte", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "sentpkt": { "field": "sentpkt", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "rcvdpkt": { "field": "rcvdpkt", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "sentdelta": { "field": "sentdelta", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "rcvddelta": { "field": "rcvddelta", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "lanin": { "field": "lanin", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "lanout": { "field": "lanout", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "wanin": { "field": "wanin", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "wanout": { "field": "wanout", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "app": { "field": "app", "kind": "semantic", "class": "text" },
      "appid": { "field": "appid", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "appcat": { "field": "appcat", "kind": "semantic", "class": "text" },
      "apprisk": { "field": "apprisk", "kind": "semantic", "class": "word" },
      "applist": { "field": "applist", "kind": "semantic", "class": "text" },
      "appact": { "field": "appact", "kind": "semantic", "class": "word" },
      "countapp": { "field": "countapp", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "countav": { "field": "countav", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "countdlp": { "field": "countdlp", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "countips": { "field": "countips", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "countweb": { "field": "countweb", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "crscore": { "field": "crscore", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "craction": { "field": "craction", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
      "crlevel": { "field": "crlevel", "kind": "semantic", "class": "word" },
      "user": { "field": "user", "kind": "semantic", "class": "text" },
      "group": { "field": "group", "kind": "semantic", "class": "text" },
      "authserver": { "field": "authserver", "kind": "semantic", "class": "text" },
      "identifier": { "field": "identifier", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "opaque" } },
      "devtype": { "field": "devtype", "kind": "semantic", "class": "text" },
      "devcategory": { "field": "devcategory", "kind": "semantic", "class": "text" },
      "osname": { "field": "osname", "kind": "semantic", "class": "text" },
      "vwlid": { "field": "vwlid", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "opaque" } },
      "vwlquality": { "field": "vwlquality", "kind": "semantic", "class": "text" }
    }
  }
}
