{
  "schema_version": "1.0.0",
  "spec_id": "draft-asa-302013",
  "description": "Cisco ASA/FTD %ASA-6-302013 'Built inbound/outbound TCP connection'. Payload after syslog-envelope unwrap starts at the message id. Endpoints are interface:host/port with a parenthesised mapped (NAT) pair; hosts may be IPs or names (non-canonical corpus lines use names). Optional trailing '(user)'.",
  "regex_dialect": "re2",
  "bounds": { "max_event_bytes": 8192, "max_fields": 64, "max_nesting": 4, "max_repeat": 16 },
  "root": [
    { "op": "regex", "pattern": "(?P<msg_id>%(?:ASA|FTD|PIX)-(?:[a-z]+-)?[0-7]-302013)",
      "captures": { "msg_id": { "field": "msg_id", "kind": "semantic", "class": "text" } } },
    { "op": "regex", "pattern": ":? ", "captures": {} },
    { "op": "regex",
      "pattern": "Built (?P<direction>inbound|outbound) (?P<proto>TCP|UDP|SCTP) connection (?P<conn_id>[0-9]+) for (?P<src_if>[^:]+):(?P<src_host>[^/\\s]+)/(?P<src_port>[0-9]+) \\((?P<src_mapped_host>[^/\\s]+)/(?P<src_mapped_port>[0-9]+)\\)(?:\\((?P<src_user>[^()]+)\\))? to (?P<dst_if>[^:]+):(?P<dst_host>[^/\\s]+)/(?P<dst_port>[0-9]+) \\((?P<dst_mapped_host>[^/\\s]+)/(?P<dst_mapped_port>[0-9]+)\\)(?:\\((?P<dst_user>[^()]+)\\))?",
      "captures": {
        "src_user": { "field": "src_user", "kind": "semantic", "class": "text" },
        "dst_user": { "field": "dst_user", "kind": "semantic", "class": "text" },
        "direction": { "field": "direction", "kind": "semantic", "class": "word", "coerce": { "op": "coerce", "to": "enum", "values": ["inbound", "outbound"], "on_failure": "reject" } },
        "proto": { "field": "proto", "kind": "semantic", "class": "word" },
        "conn_id": { "field": "conn_id", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
        "src_if": { "field": "src_if", "kind": "semantic", "class": "text" },
        "src_host": { "field": "src_host", "kind": "semantic", "class": "text" },
        "src_port": { "field": "src_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
        "src_mapped_host": { "field": "src_mapped_host", "kind": "semantic", "class": "text" },
        "src_mapped_port": { "field": "src_mapped_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
        "dst_if": { "field": "dst_if", "kind": "semantic", "class": "text" },
        "dst_host": { "field": "dst_host", "kind": "semantic", "class": "text" },
        "dst_port": { "field": "dst_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } },
        "dst_mapped_host": { "field": "dst_mapped_host", "kind": "semantic", "class": "text" },
        "dst_mapped_port": { "field": "dst_mapped_port", "kind": "semantic", "class": "integer", "coerce": { "op": "coerce", "to": "int", "on_failure": "reject" } }
      } },
    { "op": "optional", "step": { "op": "regex", "pattern": " \\((?P<user>[^()]+)\\)",
      "captures": { "user": { "field": "user", "kind": "semantic", "class": "text" } } } }
  ]
}
