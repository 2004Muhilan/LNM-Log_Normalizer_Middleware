{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulpf.local/contracts/ambiguity-certificate/1.0.0",
  "title": "ULPF ambiguity certificate",
  "description": "Emitted when the acceptance policy cannot establish a mandatory (or requested) field's OCSF mapping from evidence. Carries the validator-enumerated candidate set, the ranked competing candidates, itemised evidence status, and either a targeted evidence request (a library discriminator applies), an unresolved marker (none applies), or the recorded resolution. There is no numeric confidence anywhere in this contract, by design; a validator additionally rejects any key named confidence, probability or score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certificate_id", "created_at", "source_id", "family_id", "context", "field", "event_class", "enumeration", "ranked_candidates", "evidence", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "certificate_id": { "type": "string", "pattern": "^cert_[0-9A-Za-z_-]{6,64}$" },
    "created_at": { "$ref": "#/$defs/rfc3339" },
    "source_id": { "$ref": "#/$defs/slug" },
    "pack_id": { "$ref": "#/$defs/slug" },
    "family_id": { "$ref": "#/$defs/slug" },
    "context": {
      "type": "object",
      "description": "The structural context of the field. Together with source_id this is the propagation key: a resolution applies to every family with the same source_id, identical L1–L3 signature, slot index and token class.",
      "additionalProperties": false,
      "required": ["l1_envelope", "l2_structure", "l3_anchors", "slot_index", "token_class"],
      "properties": {
        "l1_envelope": { "$ref": "#/$defs/l1" },
        "l2_structure": { "$ref": "#/$defs/l2" },
        "l3_anchors": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 256 }, "description": "Anchor values admitted for this family (empty for anchor-sparse sources)." },
        "slot_index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "token_class": { "$ref": "#/$defs/token_class" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/field_path" },
        "sample_values": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 512 } }
      }
    },
    "event_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "name", "ocsf_version"],
      "properties": {
        "uid": { "type": "integer", "minimum": 0 },
        "name": { "$ref": "#/$defs/slug" },
        "ocsf_version": { "$ref": "#/$defs/semver" }
      }
    },
    "enumeration": {
      "type": "object",
      "description": "The deterministic validator enumeration over the pinned (complete) attribute table of the event class. Structural determination and the ambiguity decision are computed over 'survivors', never over model proposals.",
      "additionalProperties": false,
      "required": ["method", "table_hash", "candidates", "survivors"],
      "properties": {
        "method": { "const": "validator-enumeration" },
        "table_hash": { "$ref": "#/$defs/sha256", "description": "sha256 of the pinned OCSF class table used." },
        "candidates": {
          "type": "array",
          "description": "Every attribute in the class table whose type accepts a value of this token class, before validation.",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/attribute_ref" }
        },
        "survivors": {
          "type": "array",
          "description": "Candidates that survive type validation, held-out checks and value-domain constraints.",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ocsf_attribute" }
        }
      }
    },
    "ranked_candidates": {
      "type": "array",
      "description": "The competing mappings presented to the operator, ranked. Must be a subset of enumeration.survivors and, for status ambiguous/unresolved, at least two. Rank is ordinal; no scores.",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "attribute", "proposed_by"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "attribute": { "$ref": "#/$defs/ocsf_attribute" },
          "proposed_by": { "type": "string", "enum": ["model", "fixture", "operator", "enumeration"] },
          "note": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_metadata", "structural", "held_out_consistency", "type_validity", "discriminator"],
      "properties": {
        "vendor_metadata": { "type": "string", "enum": ["absent", "partial", "present"] },
        "structural": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["none", "weak", "strong", "tied"] },
            "note": { "type": "string", "maxLength": 512 }
          }
        },
        "held_out_consistency": { "type": "string", "enum": ["tied", "favours_rank_1", "not_applicable"] },
        "type_validity": { "type": "string", "enum": ["tied", "favours_rank_1", "not_applicable"] },
        "discriminator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["available", "none"] },
            "ambiguity_class": { "$ref": "#/$defs/slug" },
            "library_version": { "$ref": "#/$defs/semver" }
          },
          "allOf": [
            { "if": { "properties": { "status": { "const": "available" } } }, "then": { "required": ["ambiguity_class", "library_version"] } }
          ]
        }
      }
    },
    "status": { "type": "string", "enum": ["ambiguous", "unresolved", "resolved"] },
    "unresolved_reason": { "type": "string", "enum": ["no_library_discriminator", "discriminator_evidence_unavailable"] },
    "request": {
      "type": "object",
      "description": "Present when status is ambiguous (and retained on resolved). The lowest-cost sufficient discriminator selected by direct lookup; alternatives are listed for the operator.",
      "additionalProperties": false,
      "required": ["ambiguity_class", "sufficiency_group", "selected", "alternatives", "text"],
      "properties": {
        "ambiguity_class": { "$ref": "#/$defs/slug" },
        "sufficiency_group": { "type": "string", "description": "Identifier shared by every certificate that the same single evidence item resolves.", "pattern": "^sg_[0-9A-Za-z_-]{4,64}$" },
        "selected": { "$ref": "#/$defs/discriminator_choice" },
        "alternatives": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/discriminator_choice" } },
        "text": { "type": "string", "description": "The request as shown to the operator.", "minLength": 1, "maxLength": 2000 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discriminator_id", "provenance", "resolved_to", "evidence_ref", "operator_id", "resolved_at", "propagation_scope"],
      "properties": {
        "discriminator_id": { "$ref": "#/$defs/slug" },
        "provenance": { "$ref": "#/$defs/sufficient_provenance" },
        "resolved_to": { "$ref": "#/$defs/ocsf_attribute" },
        "evidence_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "summary"],
          "properties": {
            "kind": { "type": "string", "enum": ["operator_input", "document", "labelled_sample", "correlated_source"] },
            "summary": { "type": "string", "maxLength": 2000 },
            "hash": { "$ref": "#/$defs/sha256" }
          }
        },
        "operator_id": { "$ref": "#/$defs/slug" },
        "resolved_at": { "$ref": "#/$defs/rfc3339" },
        "propagation_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "l1_envelope", "l2_structure", "l3_anchors", "slot_index", "token_class"],
          "properties": {
            "source_id": { "$ref": "#/$defs/slug" },
            "l1_envelope": { "$ref": "#/$defs/l1" },
            "l2_structure": { "$ref": "#/$defs/l2" },
            "l3_anchors": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 256 } },
            "slot_index": { "type": "integer", "minimum": 0, "maximum": 4095 },
            "token_class": { "$ref": "#/$defs/token_class" }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "ambiguous" } } }, "then": { "required": ["request"], "not": { "anyOf": [ { "required": ["resolution"] }, { "required": ["unresolved_reason"] } ] } } },
    { "if": { "properties": { "status": { "const": "unresolved" } } }, "then": { "required": ["unresolved_reason"], "not": { "required": ["resolution"] } } },
    { "if": { "properties": { "status": { "const": "resolved" } } }, "then": { "required": ["resolution"], "not": { "required": ["unresolved_reason"] } } },
    { "if": { "properties": { "status": { "enum": ["ambiguous", "unresolved"] } } }, "then": { "properties": { "ranked_candidates": { "minItems": 2 } } } },
    { "if": { "properties": { "evidence": { "properties": { "discriminator": { "properties": { "status": { "const": "none" } }, "required": ["status"] } }, "required": ["discriminator"] } } }, "then": { "not": { "properties": { "status": { "const": "ambiguous" } } } } }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rfc3339": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "field_path": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[[0-9]+\\])?(\\.[A-Za-z0-9_][A-Za-z0-9_.\\-]*(\\[[0-9]+\\])?)*$", "maxLength": 320 },
    "ocsf_attribute": { "type": "string", "description": "Dotted OCSF attribute path within the event class, e.g. src_endpoint.ip.", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$", "maxLength": 256 },
    "attribute_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "type"],
      "properties": {
        "attribute": { "$ref": "#/$defs/ocsf_attribute" },
        "type": { "type": "string", "maxLength": 64 },
        "basis": { "type": "string", "maxLength": 256 }
      }
    },
    "token_class": { "type": "string", "enum": ["integer", "float", "ipv4", "ipv6", "ip", "mac", "url", "hostname", "uuid", "hex", "word", "text"] },
    "l1": { "type": "string", "enum": ["raw", "rfc3164", "rfc5424", "cef", "leef", "json", "xml", "csv"] },
    "l2": { "type": "string", "enum": ["positional", "kv", "csv", "json", "xml", "mixed", "template"] },
    "cost_tier": {
      "type": "string",
      "description": "Ordinal acquisition cost. Never a number.",
      "enum": ["free_if_available", "one_labelled_sample", "correlated_source"]
    },
    "discriminator_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discriminator_id", "cost_tier", "rank", "resolves"],
      "properties": {
        "discriminator_id": { "$ref": "#/$defs/slug" },
        "cost_tier": { "$ref": "#/$defs/cost_tier" },
        "rank": { "type": "integer", "minimum": 1 },
        "resolves": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/field_path" } },
        "note": { "type": "string", "maxLength": 512 }
      }
    },
    "sufficient_provenance": {
      "type": "string",
      "description": "The five sufficient provenance categories. model_proposal is deliberately absent: it can never be the provenance of a resolution.",
      "enum": ["vendor_schema_or_device_configuration", "validated_discriminator", "resolved_ambiguity_certificate", "operator_assertion", "structural_determination"]
    }
  }
}
