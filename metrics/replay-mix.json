 "mixes": [
  {"id": "corpus-lines",
   "label": "every corpus line weighted equally",
   "assumption": "Traffic is distributed like the fixture files: each of the 1,316 four-vendor corpus lines carries the same weight. Known to be false as a traffic model — fixtures are collections of parser test cases, roughly one line per case, so rare message types are heavily over-represented. It is here because it assumes nothing beyond the corpus and is the least favourable declared mix.",
   "weights": "pool_lines"},
  {"id": "equal-sources",
   "label": "four sources at 25 % each; within a source, by corpus line count",
   "assumption": "The four sources contribute equal volume; inside a source, strata keep their corpus proportions. Removes the accident that the PAN-OS fixtures are 40 % of all corpus lines; still inherits the over-representation of rare message types inside each source.",
   "weights": {"source": {"cisco-asa": 1, "paloalto-panos": 1, "fortinet-fortigate": 1, "squid": 1}}},
  {"id": "connection-heavy",
   "label": "four sources at 25 %; 80 % of each firewall's volume is connection/traffic logging",
   "assumption": "A firewall logs every connection, and management, threat and system events are comparatively rare: 80 % of each source's volume is assigned to its connection-class strata and 20 % to everything else, by corpus line count inside each class. The 80 % is a round number chosen by us, not taken from any capture; this is the mix most favourable to ULPF because the onboarded families are connection-class. Quote it only beside the other two.",
   "weights": {"source": {"cisco-asa": 1, "paloalto-panos": 1, "fortinet-fortigate": 1, "squid": 1}, "class": {"connection": 0.8, "other": 0.2}}},
  {"id": "demo-families",
