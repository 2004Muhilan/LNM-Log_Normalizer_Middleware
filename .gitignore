# Reference corpus: fetched and cached locally, never committed (licence posture, see corpus/README.md)
corpus/cache/

# OCSF definition caches (reproducible from ocsf/pinned/manifest.json)
ocsf/cache/

# Toolchain and build artefacts (the bootstrap installs Go under ~/sdk and the venv under ~/.venvs,
# outside the tree; these guard against anyone installing them inside it)
.venv/
venv/
sdk/
go-sdk/
__pycache__/
*.pyc
.pytest_cache/
runtime/bin/
*.tmp

# model weights: never in git; manifest committed, cache fetched and digest-verified
models/cache/

# dev signing keys and the signatures made with them are generated at bootstrap (scripts/keys-bootstrap.sh),
# never committed: private key material stays out of git; pack.json content is byte-identical across clones,
# its .sig is not
keys/dev/
keys/trust/*-dev.pub.json
contracts/golden/squid-native/pack.json.sig

# the live demo's state and the replay capture/zip carry Elastic-licensed fixture lines (corpus/README.md):
# they are produced locally (demo/reset.sh, demo/replay/capture.sh, demo/replay/build.sh) and never committed
demo-replay.zip
demo-replay/
demo/replay/capture/
demo/replay/state-real/
ulpf-demo/
ulpf-demo-capture/
