# Copy to deploy/.env (git-ignored). Every value here has a default; set only what differs on this machine.
# ULPF_PROCESSES=2                   runtime processes at start (each one a runtime container; add/remove later from the page)
# ULPF_PROVIDER=model                model | fixture (team-authored proposals: the generator demo only)
# ULPF_MODEL_URL=http://127.0.0.1:8081
# ULPF_MODELS_DIR=./models          the weights (digest-verified against models/manifest.json on every onboarding)
# ULPF_DASHBOARDS=1                  0: OpenSearch without Dashboards (less memory)
# ULPF_OS_HEAP=512m
# ULPF_TCP_PORT=6515                 syslog over TCP (RFC 6587), every address in devices mode
# ULPF_HTTP_PORT=8516
# ULPF_CONSOLE_PORT=8765
# ULPF_LAKE_PORT=8792                process i's lake writer: this port + i - 1
# ULPF_WITNESS_PORT=8796
# ULPF_SCALER_PORT=8797
# ULPF_OS_PORT=9200
# ULPF_OSD_PORT=5601
# ULPF_GENERATOR_PORT=8780
# ULPF_LAB_AGENT=http://127.0.0.1:8799   devices mode: the lab agent (demo/devices/agent)
# ULPF_PROJECT=ulpf                  a second installation on the same host needs its own project name and ports
